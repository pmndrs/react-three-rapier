{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": false,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    // Typecheck and test against the workspace sources rather than built `dist/` output (mirrors
    // the aliases in vitest.config.mts). Subpath entries map to `src/<name>/index.ts`.
    "paths": {
      "@react-three/rapier": ["./packages/react-three-rapier/src/index.ts"],
      "@react-three/rapier/*": ["./packages/react-three-rapier/src/*"],
      "@react-three/rapier-addons": [
        "./packages/react-three-rapier-addons/src/index.ts"
      ]
    }
  },
  "include": ["packages/*/src", "packages/*/tests", "vitest.config.mts"]
}

{
  "name": "@react-three/rapier-addons",
  "version": "5.0.0",
  "description": "Addons for @react-three/rapier",
  "keywords": [
    "physics",
    "rapier",
    "react-three-fiber",
    "react",
    "three"
  ],
  "license": "MIT",
  "homepage": "https://github.com/pmndrs/react-three-rapier",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pmndrs/react-three-rapier.git",
    "directory": "packages/react-three-rapier-addons"
  },
  "bugs": {
    "url": "https://github.com/pmndrs/react-three-rapier/issues"
  },
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist/index.*",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && rollup --config rollup.config.mjs",
    "check:package": "publint --strict && attw --pack ."
  },
  "peerDependencies": {
    "@react-three/fiber": ">=10.0.0-0",
    "@react-three/rapier": "^3.0.0-0",
    "react": ">=19.0 <19.3",
    "three": ">=0.185.0"
  },
  "devDependencies": {
    "@react-three/fiber": "10.0.0-canary.a056612",
    "@react-three/rapier": "workspace:*",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/three": "0.186.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.186.1"
  }
}

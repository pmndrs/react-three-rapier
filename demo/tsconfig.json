{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": false,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "noEmit": true,
    "jsx": "react-jsx",
    // The demo runs against the workspace sources (see the aliases in vite.config.mts), so it
    // needs no `yarn build` first and picks up library changes with HMR.
    "paths": {
      "@react-three/rapier": ["../packages/react-three-rapier/src/index.ts"],
      "@react-three/rapier/*": ["../packages/react-three-rapier/src/*"],
      "@react-three/rapier-addons": [
        "../packages/react-three-rapier-addons/src/index.ts"
      ]
    }
  },
  "include": ["src", "vite-env.d.ts"]
}

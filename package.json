{
  "name": "react-three-rapier",
  "version": "0.1.0",
  "private": true,
  "repository": "https://github.com/pmndrs/react-three-rapier",
  "author": "Hugo Wiledal <hugo.wiledal@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/cli": "3.0.3",
    "@commitlint/cli": "17.1.2",
    "@commitlint/config-conventional": "17.1.0",
    "@eslint/js": "9.39.5",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@vitest/ui": "5.0.3",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "prettier": "3.9.9",
    "publint": "0.3.25",
    "rollup": "4.64.3",
    "rollup-plugin-dts": "6.5.1",
    "rollup-plugin-esbuild": "6.2.1",
    "rollup-plugin-filesize": "10.0.0",
    "simple-git-hooks": "2.8.0",
    "typedoc": "0.23.24",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.3",
    "vitest-canvas-mock": "1.2.0"
  },
  "scripts": {
    "build": "yarn workspaces foreach -A -t --no-private run build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "yarn typecheck && vitest run",
    "test:ui": "vitest --ui",
    "check:packages": "yarn workspaces foreach -A --no-private run check:package",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ci": "yarn typecheck && yarn build && yarn check:packages && vitest run",
    "demo": "yarn workspace demo dev",
    "demo:build": "yarn workspace demo build",
    "docs": "curl -sL https://raw.githubusercontent.com/pmndrs/docs/refs/heads/main/preview.sh | MDX=docs ICON=🤺 LOGO=https://github.com/pmndrs/react-three-rapier/raw/main/packages/react-three-rapier/misc/hero.svg NEXT_PUBLIC_LIBNAME='React Three Rapier' NEXT_PUBLIC_LIBNAME_SHORT='r3/rapier' GITHUB=https://github.com/pmndrs/react-three-rapier sh",
    "docs:site:build": "npx -y @pmndrs/docs@4 build docs docs/out --format website --libname \"React Three Rapier\" --libname-short \"r3/rapier\" --home-redirect \"/getting-started/introduction\" --icon \"🤺\" --logo \"https://github.com/pmndrs/react-three-rapier/raw/main/packages/react-three-rapier/misc/hero.svg\" --github \"https://github.com/pmndrs/react-three-rapier\" --discord \"https://discord.gg/ZZjjNvJ\"",
    "docs:build": "typedoc --out ./packages/react-three-rapier/docs ./packages/react-three-rapier/src/index.ts --excludeInternal",
    "changeset:version": "changeset version && yarn install --mode update-lockfile",
    "changeset:publish": "yarn build && yarn test && changeset publish",
    "prerelease:enter": "changeset pre enter alpha",
    "prerelease:exit": "changeset pre exit"
  },
  "simple-git-hooks": {
    "commit-msg": "npx --no -- commitlint --edit ${1}",
    "pre-commit": "yarn typecheck"
  },
  "workspaces": [
    "packages/*",
    "demo"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "yarn@4.18.1"
}

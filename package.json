{
  "name": "react-three-rapier",
  "version": "0.1.0",
  "private": true,
  "repository": "https://github.com/pmndrs/react-three-rapier",
  "author": "Hugo Wiledal <hugo.wiledal@gmail.com>",
  "license": "MIT",
  "prettier": {
    "trailingComma": "none",
    "tabWidth": 2,
    "useTabs": false,
    "semi": true,
    "singleQuote": false,
    "arrowParens": "always"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/cli": "2.27.1",
    "@commitlint/cli": "17.1.2",
    "@commitlint/config-conventional": "17.1.0",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@vitest/ui": "5.0.3",
    "esbuild": "0.28.2",
    "jsdom": "30.1.2",
    "prettier": "2.7.1",
    "publint": "0.3.25",
    "rollup": "4.64.3",
    "rollup-plugin-dts": "6.5.1",
    "rollup-plugin-esbuild": "6.2.1",
    "rollup-plugin-filesize": "10.0.0",
    "simple-git-hooks": "2.8.0",
    "typedoc": "0.23.24",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.3",
    "vitest-canvas-mock": "1.2.0"
  },
  "scripts": {
    "build": "yarn workspaces foreach -A -t --no-private run build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "yarn typecheck && vitest run",
    "test:ui": "vitest --ui",
    "check:packages": "yarn workspaces foreach -A --no-private run check:package",
    "ci": "yarn typecheck && yarn build && yarn check:packages && vitest run",
    "demo": "yarn workspace demo dev",
    "demo:build": "yarn workspace demo build",
    "release": "yarn build && changeset publish",
    "docs:build": "typedoc --out ./packages/react-three-rapier/docs ./packages/react-three-rapier/src/index.ts --excludeInternal",
    "canary:enter": "changeset pre enter canary",
    "canary:exit": "changeset pre exit"
  },
  "simple-git-hooks": {
    "commit-msg": "npx --no -- commitlint --edit ${1}",
    "pre-commit": "yarn prettier packages/ demo/ --check; yarn ci"
  },
  "workspaces": [
    "packages/*",
    "demo"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "yarn@4.18.1"
}
